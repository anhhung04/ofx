# =============================================================================
# OFX Debian Package Builder
# =============================================================================
# Builds .deb packages using FPM for reliable, reproducible output.
#
# Usage:
#   docker build -f Dockerfile.deb --target=export --output type=local,dest=dist/packages .
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Build Python Wheel
# -----------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS wheel-builder

RUN pip install --no-cache-dir uv

WORKDIR /build
COPY pyproject.toml README.md uv.lock ./
COPY src/ ./src/

RUN uv build --wheel
RUN mkdir -p /output/site-packages && \
    pip install --no-cache-dir --no-deps --target=/output/site-packages dist/*.whl && \
    cp dist/*.whl /output/

# -----------------------------------------------------------------------------
# Stage 2: Build Debian Package with FPM
# -----------------------------------------------------------------------------
FROM ruby:3.2-slim-bookworm AS fpm-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    binutils \
    dpkg \
    dos2unix \
    && rm -rf /var/lib/apt/lists/*

RUN gem install fpm --no-document

WORKDIR /build

COPY --from=wheel-builder /output/*.whl ./
COPY --from=wheel-builder /output/site-packages /staging/opt/ofx/site-packages
COPY pyproject.toml ./
COPY packaging/OFX.1 ./

RUN WHEEL=$(ls ofx-*.whl | head -1) && \
    VERSION=$(echo $WHEEL | sed -n 's/ofx-\([0-9.]*\)-.*/\1/p') && \
    echo "$VERSION" > /build/VERSION && \
    echo "Building OFX version: $VERSION"

RUN mkdir -p /staging/opt/ofx/site-packages

RUN mkdir -p /staging/usr/bin && \
    printf '%s\n' \
    '#!/usr/bin/env python3' \
    '# -*- coding: utf-8 -*' \
    'import sys' \
    'import os' \
    '' \
    '# Ensure a valid working directory (handles deleted CWD)' \
    'try:' \
    '    os.getcwd()' \
    'except FileNotFoundError:' \
    '    os.chdir(os.path.expanduser("~") or "/tmp")' \
    '' \
    '# Add OFX site-packages to sys.path' \
    'ofx_site_packages = os.path.join("/opt/ofx", "site-packages")' \
    'if ofx_site_packages not in sys.path:' \
    '    sys.path.insert(0, ofx_site_packages)' \
    '' \
    '# Import and run the OFX main function' \
    'from ofx.__main__ import main' \
    'if __name__ == "__main__":' \
    '    if sys.argv[0].endswith("-script.pyw"):' \
    '        sys.argv[0] = sys.argv[0][:-11]' \
    '    sys.exit(main())' \
    > /staging/usr/bin/ofx && \
    chmod +x /staging/usr/bin/ofx

RUN mkdir -p /staging/usr/share/ofx

RUN mkdir -p /staging/usr/lib/python3/dist-packages && \
    printf '%s\n' '/opt/ofx/site-packages' > /staging/usr/lib/python3/dist-packages/ofx.pth

RUN mkdir -p /staging/usr/share/man/man1 && \
    dos2unix OFX.1 2>/dev/null || true && \
    cp OFX.1 /staging/usr/share/man/man1/


RUN mkdir -p /output

RUN printf '%s\n' \
    '#!/bin/bash' \
    'set -e' \
    '' \
    'LOG_FILE="/var/log/ofx_install.log"' \
    'echo "OFX: Dependencies are managed by apt; no pip install performed" >> "$LOG_FILE"' \
    'echo "OFX: Post-install script completed" >> "$LOG_FILE"' \
    > /build/postinst.sh

RUN dos2unix /build/postinst.sh && chmod +x /build/postinst.sh

RUN printf '%s\n' \
    '#!/bin/bash' \
    '# Clean up OFX site-packages on package removal' \
    'if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then' \
    'rm -rf /opt/ofx 2>/dev/null || true' \
    'fi' \
    > /build/postrm.sh

RUN dos2unix /build/postrm.sh && chmod +x /build/postrm.sh

RUN VERSION=$(cat /build/VERSION) && \
    fpm -s dir \
    -t deb \
    -C /staging \
    -n ofx \
    -v "$VERSION" \
    --iteration 1 \
    --architecture all \
    --description "Offensive Flow Executor - Red Team Automation Tool. OFX is a comprehensive toolkit for red team operations including exploitation, post-exploitation, enumeration utilities, and webshell management." \
    --url "https://anhhung04.github.io/ofx" \
    --license "MIT" \
    --maintainer "OFX Developer <dev.hah4@gmail.com>" \
    --vendor "OFX Project" \
    --category "utils" \
    --depends "python3 (>= 3.12)" \
    --depends "python3-aiofiles" \
    --depends "python3-cryptography" \
    --depends "python3-filelock" \
    --depends "python3-git" \
    --depends "python3-httpx" \
    --depends "python3-jinja2" \
    --depends "python3-pydantic" \
    --depends "python3-pydantic-settings" \
    --depends "python3-pykeepass" \
    --depends "python3-yaml" \
    --depends "python3-requests" \
    --depends "python3-rich" \
    --depends "python3-tabulate" \
    --depends "python3-typer" \
    --after-install /build/postinst.sh \
    --after-remove /build/postrm.sh \
    -p /output/ofx_${VERSION}-1_all.deb \
    . && \
    echo "Debian package built successfully"

RUN cp *.whl /output/
RUN echo "=== Built packages ===" && ls -la /output/

# -----------------------------------------------------------------------------
# Stage 3: Export Debian package
# -----------------------------------------------------------------------------
FROM scratch AS export
COPY --from=fpm-builder /output/* /
COPY --from=wheel-builder /output/*.whl /