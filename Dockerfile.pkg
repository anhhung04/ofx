# =============================================================================
# OFX Multi-Platform Package Builder
# =============================================================================
# Builds .deb and .rpm packages for multiple architectures
#
# Usage:
#   # Build for current platform
#   docker build -f Dockerfile.pkg --target=export --output type=local,dest=dist/packages .
#
#   # Build for multiple architectures (requires docker buildx)
#   docker buildx build -f Dockerfile.pkg --platform linux/amd64,linux/arm64 \
#     --target=export --output type=local,dest=dist/packages .
#
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Build Debian Package (.deb)
# -----------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS deb-builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    devscripts \
    debhelper \
    dh-python \
    python3-all \
    python3-pip \
    python3-setuptools \
    python3-build \
    fakeroot \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy source
COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY debian/ ./debian/

# Make rules executable
RUN chmod +x debian/rules

# Build the .deb package
RUN dpkg-buildpackage -us -uc -b

# Move output to accessible location
RUN mkdir -p /output/deb && mv ../*.deb /output/deb/

# -----------------------------------------------------------------------------
# Stage 2: Build RPM Package (.rpm)
# -----------------------------------------------------------------------------
FROM fedora:39 AS rpm-builder

# Install build dependencies
RUN dnf install -y \
    python3-devel \
    python3-pip \
    python3-setuptools \
    rpm-build \
    rpmdevtools \
    && dnf clean all

WORKDIR /build

# Copy source
COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY packaging/rpm/ ./packaging/rpm/

# Setup RPM build tree
RUN rpmdev-setuptree

# Build Python wheel first
RUN python3 -m pip install build && python3 -m build --wheel

# Copy wheel to SOURCES
RUN cp dist/*.whl /root/rpmbuild/SOURCES/

# Build RPM from spec
RUN rpmbuild -bb packaging/rpm/ofx.spec \
    --define "_topdir /root/rpmbuild" \
    --define "_sourcedir /root/rpmbuild/SOURCES"

# Move output
RUN mkdir -p /output/rpm && mv /root/rpmbuild/RPMS/*/*.rpm /output/rpm/

# -----------------------------------------------------------------------------
# Stage 3: Build Python Wheel (universal)
# -----------------------------------------------------------------------------
FROM python:3.12-slim AS wheel-builder

RUN pip install build

WORKDIR /build
COPY pyproject.toml README.md ./
COPY src/ ./src/

RUN python -m build --wheel
RUN mkdir -p /output/wheel && mv dist/*.whl /output/wheel/

# -----------------------------------------------------------------------------
# Stage 4: Export all packages
# -----------------------------------------------------------------------------
FROM scratch AS export

# Copy all built packages
COPY --from=deb-builder /output/deb/* /
COPY --from=rpm-builder /output/rpm/* /
COPY --from=wheel-builder /output/wheel/* /
