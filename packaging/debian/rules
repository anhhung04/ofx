#!/usr/bin/make -f

export PYBUILD_NAME=ofx
export DH_VERBOSE=1

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	# Create data directory
	mkdir -p debian/ofx/usr/share/ofx
	# Copy any data files if they exist
	if [ -d "src/ofx/data" ]; then \
		cp -r src/ofx/data/* debian/ofx/usr/share/ofx/; \
	fi

override_dh_auto_test:
	# Skip tests during package build
	@echo "Skipping tests during package build"
